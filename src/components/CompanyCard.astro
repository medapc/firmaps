---
interface Props {
  name: string;
  slug: string;
  category: string;
  city: string;
  district: string;
  rating: number;
  reviewCount: number;
  service: string;
  description: string;
  image: string;
  price: string;
  isVerified?: boolean;
}

const { name, slug, category, city, district, rating, reviewCount, service, description, image, price, isVerified = false } = Astro.props as Props;
---

<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_18px_40px_rgba(15,23,42,0.04)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_rgba(249,115,22,0.12)]">
  <div class="relative overflow-hidden">
    <img src={image} alt={name} class="h-52 w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" width="800" height="560" />
    <div class="absolute left-3 top-3 flex items-center gap-2">
      {isVerified && (
        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-white/95 px-2.5 py-1 text-[10px] font-semibold text-emerald-700 shadow-sm backdrop-blur-sm">
          <span aria-hidden="true">✓</span>
          <span>Onaylı</span>
        </span>
      )}
      <span class="inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-semibold text-slate-700 backdrop-blur-sm">
        <span>★</span>
        <span>{rating.toFixed(1)}</span>
      </span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <span class="inline-flex items-center gap-2 rounded-full bg-orange-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-orange-600">
        {category}
      </span>
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-semibold text-slate-600">{price}</span>
    </div>

    <h3 class="mt-4 text-lg font-bold text-slate-900">{name}</h3>

    <div class="mt-3 space-y-1.5 text-sm text-slate-600">
      <div class="flex items-center gap-2">
        <span aria-hidden="true">★</span>
        <span>{rating.toFixed(1)} <span class="text-slate-500">({reviewCount})</span></span>
      </div>
      <div class="flex items-center gap-2">
        <span aria-hidden="true">📍</span>
        <span>{city}, {district}</span>
      </div>
      <div class="flex items-center gap-2">
        <span aria-hidden="true">🛠️</span>
        <span>{service}</span>
      </div>
    </div>

    <div class="mt-auto pt-4">
      <a href={`/firma/${slug}`} class="inline-flex items-center justify-center w-full rounded-full bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800">
        Detay
      </a>
    </div>
  </div>
</article>
