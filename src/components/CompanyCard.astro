---
interface Props {
  name: string;
  slug: string;
  category: string;
  city: string;
  district: string;
  rating: number;
  reviewCount: number;
  service: string;
  description: string;
  image: string;
  price: string;
}

const { name, slug, category, city, district, rating, reviewCount, service, description, image, price } = Astro.props as Props;
---

<article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_18px_40px_rgba(15,23,42,0.04)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_rgba(249,115,22,0.12)]">
  <div class="relative overflow-hidden">
    <img src={image} alt={name} class="h-56 w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" width="800" height="560" />
    <div class="absolute left-3 top-3 inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-700 backdrop-blur-sm">
      <span>★</span>
      <span>{rating.toFixed(1)}</span>
    </div>
  </div>
  <div class="space-y-4 p-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-orange-500">{category}</p>
        <h3 class="mt-2 text-xl font-semibold text-slate-900">{name}</h3>
      </div>
      <span class="rounded-full bg-orange-50 px-2.5 py-1 text-xs font-semibold text-orange-600">{price}</span>
    </div>

    <div class="flex items-center gap-2 text-sm text-slate-500">
      <span>{city}</span>
      <span>•</span>
      <span>{district}</span>
    </div>

    <p class="text-sm font-medium text-slate-700">{service}</p>
    <p class="text-sm leading-6 text-slate-600">{description}</p>

    <div class="flex items-center justify-between border-t border-slate-100 pt-4">
      <div class="text-sm text-slate-500">
        <span class="font-semibold text-slate-800">{reviewCount}</span> yorum
      </div>
      <a href={`/firma/${slug}`} class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-slate-800">
        Detay gör
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
