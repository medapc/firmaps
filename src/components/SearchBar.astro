<form class="mt-8 flex w-full max-w-3xl flex-col gap-3 rounded-2xl border border-slate-200 bg-white/90 p-3 shadow-[0_20px_60px_rgba(15,23,42,0.12)] backdrop-blur sm:flex-row">
  <label class="sr-only" for="search-query">Firma ara</label>
  <input
    id="search-query"
    type="text"
    value="Mimarlık, sağlık, emlak..."
    aria-label="Firma ara"
    class="h-14 flex-1 rounded-xl border border-slate-200 bg-slate-50 px-4 text-base text-slate-700 outline-none transition focus:border-orange-400 focus:bg-white focus:ring-2 focus:ring-orange-100"
  />
  <label class="sr-only" for="search-location">Şehir seç</label>
  <select
    id="search-location"
    aria-label="Şehir seç"
    class="h-14 rounded-xl border border-slate-200 bg-slate-50 px-4 text-base text-slate-700 outline-none transition focus:border-orange-400 focus:bg-white focus:ring-2 focus:ring-orange-100"
  >
    <option>İstanbul</option>
    <option>Ankara</option>
    <option>İzmir</option>
    <option>Bursa</option>
  </select>
  <button type="submit" class="h-14 rounded-xl bg-orange-500 px-6 text-base font-semibold text-white shadow-lg shadow-orange-500/20 transition hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-300">Ara</button>
</form>
