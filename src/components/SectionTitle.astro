---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props as Props;
const textAlign = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class:list={['max-w-2xl', textAlign]}>
  {eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-orange-500">{eyebrow}</p>}
  <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-slate-600">{description}</p>}
</div>
