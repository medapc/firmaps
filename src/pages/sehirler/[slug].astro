---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyCard from '../../components/CompanyCard.astro';
import { cities, companies } from '../../data/site';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { slug: city.slug }
  }));
}

const { slug } = Astro.params;
const city = cities.find((item) => item.slug === slug);

if (!city) {
  throw new Error(`Şehir bulunamadı: ${slug}`);
}

const cityCompanies = companies.filter((company) => company.citySlug === slug);
---

<BaseLayout title={`${city.name} firmaları | FirMaps`} description={`${city.name} şehrindeki güvenilir firmaları ve yerel hizmet sağlayıcıları keşfedin.`}>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 rounded-[28px] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_rgba(15,23,42,0.04)] sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange-500">Şehir rehberi</p>
          <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">{city.name}</h1>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/sehirler" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-100">Tüm şehirler</a>
          <a href="/" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-100">Ana sayfa</a>
        </div>
      </div>

      <div class="mt-6 overflow-hidden rounded-[24px] border border-slate-200">
        <img src={city.image} alt={`${city.name} şehri`} class="h-56 w-full object-cover sm:h-72" loading="lazy" width="1600" height="900" />
      </div>

      <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm leading-7 text-slate-600">
        {city.description}
      </div>
    </header>

    <section>
      <div class="mb-6 flex items-center justify-between gap-3">
        <h2 class="text-2xl font-black text-slate-900">Şehirdeki firmalar</h2>
        <span class="rounded-full bg-orange-50 px-3 py-1 text-sm font-semibold text-orange-600">{cityCompanies.length} firma</span>
      </div>

      {cityCompanies.length > 0 ? (
        <div class="grid gap-6 lg:grid-cols-3">
          {cityCompanies.map((company) => (
            <CompanyCard {...company} isVerified={company.isVerified} />
          ))}
        </div>
      ) : (
        <div class="rounded-[28px] border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
          <p class="text-lg font-semibold text-slate-700">Bu şehirde gösterilecek firma bulunamadı.</p>
          <p class="mt-2 text-sm text-slate-500">Yakın zamanda eklenmesi planlanıyor.</p>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
