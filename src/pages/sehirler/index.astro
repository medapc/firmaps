---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cities } from '../../data/site';
---

<BaseLayout title="Şehirler | FirMaps" description="Türkiye'nin popüler şehirlerinde yer alan firmaları ve lokal hizmetleri keşfedin.">
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 rounded-[28px] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_rgba(15,23,42,0.04)] sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange-500">Konum</p>
          <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">Şehirler</h1>
        </div>
        <a href="/" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-100">Ana sayfaya dön</a>
      </div>
    </header>

    <section class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {cities.map((city) => (
        <a href={`/sehirler/${city.slug}`} class="group overflow-hidden rounded-[24px] border border-slate-200 bg-white shadow-[0_18px_40px_rgba(15,23,42,0.04)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_rgba(15,23,42,0.10)]">
          <div class="relative overflow-hidden">
            <img src={city.image} alt={`${city.name} şehri`} class="h-52 w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" width="1200" height="800" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/25 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-4 text-white">
              <p class="text-[10px] uppercase tracking-[0.14em] text-orange-200">{city.count.toLocaleString('tr-TR')} firma</p>
              <h2 class="mt-1 text-2xl font-bold">{city.name}</h2>
            </div>
          </div>
          <div class="p-4">
            <p class="text-sm leading-6 text-slate-600">{city.description}</p>
            <div class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-700 group-hover:text-orange-600">
              <span>Şehirde ara</span>
              <span aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
