---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { companies } from '../../data/site';

export function getStaticPaths() {
  return companies.map((company) => ({
    params: { slug: company.slug }
  }));
}

const { slug } = Astro.params;
const company = companies.find((item) => item.slug === slug);

if (!company) {
  throw new Error(`Firma bulunamadı: ${slug}`);
}
---

<BaseLayout title={`${company.name} | FirMaps`} description={company.shortDescription}>
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-slate-500">
      <div class="flex flex-wrap items-center gap-2">
        <a href="/" class="hover:text-slate-900">Ana Sayfa</a>
        <span>›</span>
        <a href={`/firmalar/${company.categorySlug}`} class="hover:text-slate-900">{company.category}</a>
        <span>›</span>
        <a href={`/sehirler/${company.citySlug}`} class="hover:text-slate-900">{company.city}</a>
        <span>›</span>
        <span class="text-slate-700">{company.name}</span>
      </div>
    </nav>

    <article class="overflow-hidden rounded-[32px] border border-slate-200 bg-white shadow-[0_28px_80px_rgba(15,23,42,0.06)]">
      <div class="grid gap-0 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="relative min-h-[360px]">
          <img src={company.image} alt={company.name} class="h-full w-full object-cover" width="1200" height="900" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/75 via-slate-900/10 to-transparent"></div>

          <div class="absolute bottom-0 left-0 right-0 p-6 text-white sm:p-8">
            <div class="mb-3 flex items-center gap-3">
              <span class="rounded-full bg-orange-500 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white">{company.heroBadge ?? 'Firmamız'}</span>
              {company.isVerified && <span class="rounded-full bg-emerald-500/90 px-3 py-1 text-xs font-semibold">Doğrulanmış</span>}
            </div>
            <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{company.name}</h1>
            <p class="mt-3 text-base text-slate-200">{company.shortDescription}</p>
          </div>
        </div>

        <aside class="border-t border-slate-200 bg-slate-50 p-6 lg:border-l lg:border-t-0">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="text-sm uppercase tracking-[0.2em] text-slate-400">Puan</span>
              <span class="inline-flex items-center gap-2 rounded-full bg-orange-50 px-3 py-1 text-sm font-semibold text-orange-600">
                ★ {company.rating.toFixed(1)}
              </span>
            </div>

            <div class="space-y-3 text-sm text-slate-700">
              <div class="flex items-start gap-3">
                <span class="mt-1 text-orange-500">📍</span>
                <span>{company.address}</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-orange-500">📞</span>
                <a href={`tel:${company.phone.replace(/\s+/g, '')}`} class="hover:text-slate-900">{company.phone}</a>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-orange-500">🕒</span>
                <span>{company.workingHours}</span>
              </div>
            </div>

            <div class="flex flex-col gap-3 pt-2">
              <a href={company.mapsLink} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center rounded-full bg-orange-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-500/20 transition hover:bg-orange-600">Haritada aç</a>
              <a href={`tel:${company.phone.replace(/\s+/g, '')}`} class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300">Telefon et</a>
              <a
                href={`https://wa.me/${company.phone.replace(/\D/g, '')}?text=${encodeURIComponent('Merhaba, firmayı FirMaps üzerinden gördüm. Bilgi almak istiyorum.')}`}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-emerald-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-500/20 transition hover:bg-emerald-600"
              >
                <span aria-hidden="true">💬</span>
                WhatsApp
              </a>
            </div>
          </div>
        </aside>
      </div>

      <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1.3fr_0.7fr]">
        <div>
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-slate-900">Hakkımızda</h2>
            <p class="mt-4 text-base leading-8 text-slate-600">{company.description}</p>
          </section>

          <section class="mb-10">
            <h2 class="text-2xl font-bold text-slate-900">Hizmetler</h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="font-semibold text-slate-800">Transit Kesim</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">Aracınızın kullanım amacına göre milimetrik ölçülerle profesyonel kesim işlemleri.</p>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="font-semibold text-slate-800">Kaporta İmalatı</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">Kesim sonrası yeni forma uygun kaporta ve güçlendirme uygulamaları.</p>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="font-semibold text-slate-800">Özel Kasa</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">Şasi ve araç yapısına tam uygun dayanıklı özel kasa imalatı.</p>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="font-semibold text-slate-800">Genel Onarım</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">Hasarlı kaporta ve aksamların orijinal formuna dönüştürülmesi.</p>
              </div>
            </div>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-slate-900">Google Maps</h2>
            <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200">
              <iframe
                title={`${company.name} konumu`}
                src={company.mapsEmbedUrl}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="h-[320px] w-full border-0"
                allowfullscreen
              ></iframe>
            </div>
          </section>
        </div>

        <aside class="space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="text-lg font-semibold text-slate-900">Şehir & İlçe</h3>
            <div class="mt-4 space-y-3 text-sm text-slate-600">
              <p><span class="font-medium text-slate-800">Şehir:</span> {company.city}</p>
              <p><span class="font-medium text-slate-800">İlçe:</span> {company.district}</p>
              <p><span class="font-medium text-slate-800">Kategori:</span> {company.category}</p>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="text-lg font-semibold text-slate-900">İç Bağlantılar</h3>
            <ul class="mt-4 space-y-3 text-sm text-slate-600">
              <li><a href={`/firmalar/${company.categorySlug}`} class="hover:text-slate-900">{company.category} firmaları</a></li>
              <li><a href={`/sehirler/${company.citySlug}`} class="hover:text-slate-900">{company.city} firmaları</a></li>
              <li><a href={`/sehirler/${company.citySlug}/${company.districtSlug}`} class="hover:text-slate-900">{company.district} firmaları</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </article>
  </main>
</BaseLayout>
