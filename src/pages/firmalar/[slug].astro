---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyCard from '../../components/CompanyCard.astro';
import { categories, companies } from '../../data/site';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug }
  }));
}

const { slug } = Astro.params;
const category = categories.find((item) => item.slug === slug);

if (!category) {
  throw new Error(`Kategori bulunamadı: ${slug}`);
}

const categoryCompanies = companies.filter((company) => company.categorySlug === slug);
---

<BaseLayout title={`${category.name} firmaları | FirMaps`} description={`${category.name} kategorisindeki güvenilir firmaları ve hizmet sağlayıcıları keşfedin.`}>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 rounded-[28px] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_rgba(15,23,42,0.04)] sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange-500">Kategori</p>
          <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">{category.name} firmaları</h1>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/firmalar" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-100">Tüm firmalar</a>
          <a href="/" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-100">Ana sayfa</a>
        </div>
      </div>

      <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm leading-7 text-slate-600">
        {category.description}
      </div>
    </header>

    <section>
      <div class="mb-6 flex items-center justify-between gap-3">
        <h2 class="text-2xl font-black text-slate-900">Sonuçlar</h2>
        <span class="rounded-full bg-orange-50 px-3 py-1 text-sm font-semibold text-orange-600">{categoryCompanies.length} firma</span>
      </div>

      {categoryCompanies.length > 0 ? (
        <div class="grid gap-6 lg:grid-cols-3">
          {categoryCompanies.map((company) => (
            <CompanyCard {...company} isVerified={company.isVerified} />
          ))}
        </div>
      ) : (
        <div class="rounded-[28px] border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
          <p class="text-lg font-semibold text-slate-700">Bu kategoride gösterilecek firma bulunamadı.</p>
          <p class="mt-2 text-sm text-slate-500">Daha sonra tekrar kontrol edebilirsiniz.</p>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
