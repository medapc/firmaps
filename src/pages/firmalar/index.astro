---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, companies } from '../../data/site';

const featuredCompanies = companies.slice(0, 6);
---

<BaseLayout title="Firmalar | FirMaps" description="Kategori bazında güvenilir firmaları keşfedin ve ihtiyaçlarınıza uygun hizmet sağlayıcıları bulun.">
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 rounded-[28px] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_rgba(15,23,42,0.04)] sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange-500">Keşfet</p>
          <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">Firmalar</h1>
        </div>
        <a href="/" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-100">Ana sayfaya dön</a>
      </div>
    </header>

    <section class="mb-12">
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {categories.map((category) => (
          <a href={`/firmalar/${category.slug}`} class="group rounded-[24px] border border-slate-200 bg-white p-5 shadow-[0_18px_40px_rgba(15,23,42,0.04)] transition duration-200 hover:-translate-y-1 hover:border-orange-200 hover:shadow-[0_24px_50px_rgba(249,115,22,0.12)]">
            <div class="flex items-start justify-between gap-3">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-50 text-2xl">{category.icon}</div>
              <span class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-semibold text-slate-600">{category.count}+</span>
            </div>
            <h2 class="mt-5 text-lg font-bold text-slate-900">{category.name}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{category.description}</p>
            <div class="mt-5 flex items-center justify-between text-sm font-semibold text-slate-700 group-hover:text-orange-600">
              <span>{category.count} firma</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="mb-6 flex items-center justify-between gap-3">
        <h2 class="text-2xl font-black text-slate-900">Öne çıkan firmalar</h2>
        <a href="/#featured" class="text-sm font-semibold text-slate-700 transition hover:text-slate-900">Tüm firmalar</a>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {featuredCompanies.map((company) => (
          <article class="rounded-[24px] border border-slate-200 bg-white p-4 shadow-[0_18px_40px_rgba(15,23,42,0.04)]">
            <img src={company.image} alt={company.name} class="h-52 w-full rounded-2xl object-cover" loading="lazy" width="800" height="560" />
            <div class="mt-4 flex items-center justify-between gap-3">
              <span class="rounded-full bg-orange-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-orange-600">{company.category}</span>
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-semibold text-slate-600">{company.price}</span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-slate-900">{company.name}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{company.shortDescription}</p>
            <div class="mt-4 flex items-center gap-2 text-sm text-slate-600">
              <span>★</span>
              <span>{company.rating.toFixed(1)} · {company.city}</span>
            </div>
            <a href={`/firma/${company.slug}`} class="mt-5 inline-flex w-full items-center justify-center rounded-full bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800">Firma profili</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
